        <file alias="go-previous.svg">../dist/icons/go-previous.svg</file>
        <file alias="go-next.svg">../dist/icons/go-next.svg</file>
        <file alias="visibility.svg">../dist/icons/visibility.svg</file>
        <file alias="hint.svg">../dist/icons/hint.svg</file>
